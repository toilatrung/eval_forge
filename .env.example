# Copy file này thành .env và điền key thật — .env đã nằm trong .gitignore, không commit.

OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Base URL — để trống sẽ dùng endpoint mặc định của SDK (OpenAI/Anthropic chính chủ).
# Điền khi cần trỏ qua proxy, gateway nội bộ, hoặc endpoint tương thích API (OpenAI-compatible/
# Azure OpenAI/self-hosted...). llm_client.py / llm_judge.py (Phase 2) sẽ đọc 2 biến này và chỉ
# truyền base_url cho SDK khi có giá trị.
OPENAI_BASE_URL=
ANTHROPIC_BASE_URL=
